# 這些欄位會在加入 Supabase 與 Web Push 時使用。
# 請勿在此檔或前端程式放入 service role key、VAPID 私鑰或其他秘密。

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
VITE_VAPID_PUBLIC_KEY=your-public-vapid-key
VITE_TURNSTILE_SITE_KEY=your-cloudflare-turnstile-site-key

# Supabase Edge Function 另外需要下列 secret 名稱。
# 請只在 Supabase Dashboard 設定，不要取消註解、填值或保存到此檔：
# APP_SUPABASE_SECRET_KEY
# VAPID_PUBLIC_KEY
# VAPID_PRIVATE_KEY
# VAPID_SUBJECT
# CRON_SECRET
